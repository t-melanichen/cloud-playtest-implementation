    {
      "id": "m04pz1iLdi1k5LjqKZhvF",
      "type": "text",
      "x": 6972.584146866084,
      "y": 6732.030280535902,
      "width": 590,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#664d00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
