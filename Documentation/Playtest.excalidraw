      "link": null,
      "locked": false,
      "text": "GroupInfo: \nThis information needs to be either persisted OR the\nlogic to generate this needs to be kept consistent\nbetween the point when they are generated and when\nit is sent to XProduct.\n- MKMS: contentId\n- XKMS: contentId_versionId (underscore delimiter)",
      "fontSize": 15.386253720238074,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GroupInfo: \nThis information needs to be either persisted OR the logic to generate this needs to be kept consistent between the point when they are generated and when it is sent to XProduct.\n- MKMS: contentId\n- XKMS: contentId_versionId (underscore delimiter)",
      "autoResize": false,
      "lineHeight": 1.25
    },
