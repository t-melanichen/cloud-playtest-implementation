    },
    {
      "id": "129207f01b634ff6",
      "type": "text",
      "x": 46,
      "y": 1036.5,
      "width": 808,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2058577411,
      "version": 30,
      "versionNonce": 318429187,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781801768572,
      "link": null,
      "locked": false,
      "text": "①  SHARED BUILD — Passing the StoreAsset hands xCloud the same PlaytestContentId the download / publish path\nalready produced. In CTIN the ingestion SourceId is set to StoreAsset.ContentId (contract-enforced equal), so the\nSTREAMED build IS the downloadable SUCU build — xCloud does no BigCat / XProduct re-derivation.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "call1",
      "originalText": "①  SHARED BUILD — Passing the StoreAsset hands xCloud the same PlaytestContentId the download / publish path\nalready produced. In CTIN the ingestion SourceId is set to StoreAsset.ContentId (contract-enforced equal), so the\nSTREAMED build IS the downloadable SUCU build — xCloud does no BigCat / XProduct re-derivation.",
      "lineHeight": 1.25
    },
    {
      "id": "call2",
      "type": "rectangle",
      "x": 880,
      "y": 1000,
      "width": 780,
      "height": 140,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#fff3bf",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1203533129,
      "version": 30,
      "versionNonce": 912252119,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "d380c7ada55d4c80"
        }
      ],
      "updated": 1781801768572,
      "link": null,
      "locked": false
    },
    {
      "id": "d380c7ada55d4c80",
      "type": "text",
      "x": 886,
      "y": 1035.625,
      "width": 768,
      "height": 68.75,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 876082604,
      "version": 30,
      "versionNonce": 71188214,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781801768572,
      "link": null,
      "locked": false,
      "text": "②  DNA GROUPS, TWO USES — GMS resolves the audience to FlightIds → JobParameters.AllowedDnaGroups.\n(A) INSTALL: CTIN builds one XusAudience per DNA group for asset ingestion, and re-projects the same set as\nResolutionQuery.Flights for the PC install poll (SUCU).\n(B) AUTH: the full set is written to offering.AllowedDnaGroups; at login services.auth matches GsToken.DnaGroups\nagainst it (AuthorizedBy = \"DnaGroupAllowList\").",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "call2",
      "originalText": "②  DNA GROUPS, TWO USES — GMS resolves the audience to FlightIds → JobParameters.AllowedDnaGroups.\n(A) INSTALL: CTIN builds one XusAudience per DNA group for asset ingestion, and re-projects the same set as\nResolutionQuery.Flights for the PC install poll (SUCU).\n(B) AUTH: the full set is written to offering.AllowedDnaGroups; at login services.auth matches GsToken.DnaGroups\nagainst it (AuthorizedBy = \"DnaGroupAllowList\").",
      "lineHeight": 1.25
    },
