   "versionNonce": 299210380,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1781802100000,
   "link": null,
   "locked": false,
   "text": "Publish reuses the developer's already-published build; xCloud ingestion is catalog/orchestration only \u2014 the binary never moves.  Numbered steps \u2460\u2013\u2465 follow the end-to-end path.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Publish reuses the developer's already-published build; xCloud ingestion is catalog/orchestration only \u2014 the binary never moves.  Numbered steps \u2460\u2013\u2465 follow the end-to-end path.",
   "lineHeight": 1.25
