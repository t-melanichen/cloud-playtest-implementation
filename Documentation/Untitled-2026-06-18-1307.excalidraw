    {
      "id": "_I-5Kk7Iqam5ELhkicleo",
      "type": "text",
      "x": 7258.771446128188,
      "y": 6833.596049777169,
      "width": 590,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#664d00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1356825708,
      "version": 131,
      "versionNonce": 194265556,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781875307542,
      "link": null,
      "locked": false,
      "text": "③  VERIFIED + GATE / CAVEATS\nVerified in code: XBET XPackagePlaytestPublishWorkflow + XCloudPlaytestTitleIngestion-\nBuilder; CTIN PlaytestTitleIngestionWorkflow; SUCU via AssetIngestionWorkflow. Live ID\n(XboxTitleId) resolved from XORc. Gate: nonzero XboxTitleId (best-effort).\nCaveats: expiration clamp still 7d (30d decided); PC SUG unset / version pin (TODO\n62521491); PC install depends on upstream distribution enablement.",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "③  VERIFIED + GATE / CAVEATS\nVerified in code: XBET XPackagePlaytestPublishWorkflow + XCloudPlaytestTitleIngestion-\nBuilder; CTIN PlaytestTitleIngestionWorkflow; SUCU via AssetIngestionWorkflow. Live ID\n(XboxTitleId) resolved from XORc. Gate: nonzero XboxTitleId (best-effort).\nCaveats: expiration clamp still 7d (30d decided); PC SUG unset / version pin (TODO\n62521491); PC install depends on upstream distribution enablement.",
      "lineHeight": 1.25,
      "index": "bC3",
      "autoResize": true
    },
