   "seed": 1243597535,
   "version": 1,
   "versionNonce": 1593088525,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1781801900000,
   "link": null,
   "locked": false,
   "text": "\u2462  PACKAGE INGESTION\nConfigurePackage \u2192 StartAssetIngestion ESRP-signs and\nstages the build into SUCU (aka XUS) as the streaming\npackage. The same ContentId + PackageFamilyName flow to\nboth endpoints, so xCloud streams the build as published.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2462  PACKAGE INGESTION\nConfigurePackage \u2192 StartAssetIngestion ESRP-signs and\nstages the build into SUCU (aka XUS) as the streaming\npackage. The same ContentId + PackageFamilyName flow to\nboth endpoints, so xCloud streams the build as published.",
   "lineHeight": 1.25
  }
 ],
