  },
  {
   "id": "text-092",
   "type": "text",
   "x": 608,
   "y": 1074,
   "width": 470,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#664d00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 709454320,
   "version": 1,
   "versionNonce": 1088378944,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1781801900000,
   "link": null,
   "locked": false,
   "text": "\u2461  DNA GROUPS / AUDIENCE\nThe Creator defines an Audience Group of DNA groups,\nregistered in the Group Management Service (GMS).\nAllowedDnaGroups becomes the offering's audience gate; at\nlaunch services.auth checks GMS membership \u2014 grant / deny.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2461  DNA GROUPS / AUDIENCE\nThe Creator defines an Audience Group of DNA groups,\nregistered in the Group Management Service (GMS).\nAllowedDnaGroups becomes the offering's audience gate; at\nlaunch services.auth checks GMS membership \u2014 grant / deny.",
   "lineHeight": 1.25
  },
